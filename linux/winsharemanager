    def del_share():
        sel = tree.selection()
        if not sel:
            return
        name = sel[0]
        if not messagebox.askyesno('确认', '删除共享 {}？\n（只取消发布，不动磁盘文件）'.format(name)):
            return
        cfg['shares'] = [s for s in cfg['shares'] if s['name'] != name]
        save_config(cfg)
        if apply_shares(cfg):
            R.log('共享 {} 已取消发布。'.format(name), 'OK')
        refresh_all()

    def on_close():
        R.callback = None
        root.destroy()

    root.protocol('WM_DELETE_WINDOW', on_close)
    refresh_all()
    root.mainloop()


# ============================================================
# 入口
# ============================================================

def main():
    args = sys.argv[1:]
    if '--serve' in args:
        serve_mode()
        return 0
    if '--probe' in args:
        return probe_mode()
    if '--version' in args:
        print('WinShareManager for Linux v{} ({})'.format(APP_VERSION, DISTRO_ID))
        return 0
    if os.geteuid() != 0 and os.environ.get('WSM_NO_REEXEC') != '1':
        # pkexec 提权重启（桌面环境会弹密码框）；无桌面则提示 sudo
        exe = os.path.abspath(__file__)
        try:
            os.execvp('pkexec', ['pkexec', sys.executable, exe] + args)
        except OSError:
            pass
        print('需要 root 权限：请用 sudo 运行本程序。', file=sys.stderr)
        return 1
    if not _tkinter_available():
        print('缺少 tkinter：Ubuntu 执行 apt install python3-tk；CachyOS 执行 pacman -S tk', file=sys.stderr)
        return 1
    run_gui()
    return 0


if __name__ == '__main__':
    sys.exit(main())
