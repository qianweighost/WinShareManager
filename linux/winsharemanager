def smb_enabled_conf():
    """读取 smb.conf 里标记块下当前已有的共享段名。"""
    text = read_text('/etc/samba/smb.conf')
    block = ''
    m = re.search(re.escape(SMB_MARK_BEGIN) + r'(.*?)' + re.escape(SMB_MARK_END), text, re.S)
    if m:
        block = m.group(1)
    return re.findall(r'^\[([^\]]+)\]', block, re.M)


def smb_sync(cfg):
    """把配置里的 SMB 共享整体写进 smb.conf 标记块。"""
    lines = [SMB_MARK_BEGIN]
    for s in cfg['shares']:
        if 'smb' not in (s.get('protocols') or []):
            continue
        name = s['name']
        users = ', '.join(s.get('smb_users') or [])
        lines += [
            '[{}]'.format(name),
            '   comment = WinShareManager share',
            '   path = {}'.format(s['path']),
            '   browseable = yes',
            '   read only = no',
            '   guest ok = no',
            '   force user = root',
        ]
        if users:
            lines.append('   valid users = {}'.format(users))
        lines.append('')
    lines.append(SMB_MARK_END)
    replace_marked_block('/etc/samba/smb.conf', SMB_MARK_BEGIN, SMB_MARK_END, '\n'.join(lines))


def smb_sync_users(cfg):
    """把 GUI 里设置的 SMB 账号同步给 smbpasswd（密码存配置，重复设置幂等）。"""
    users = {}
    for s in cfg['shares']:
        for u in (s.get('smb_users') or []):
            if isinstance(u, dict):
                users[u['name']] = u.get('password') or ''
    for name, pwd in users.items():
        if not name:
            continue
        run(['id', name])  # 必须是系统用户
        if not pwd:
            continue
        ok, _ = run(['pdbedit', '-L'], timeout=15)
        listed = ok  # 仅作提示
        p = subprocess.run(['smbpasswd', '-a', '-s', name], input=(pwd + '\n' + pwd + '\n'),
                           capture_output=True, text=True, timeout=20)
        if p.returncode == 0:
            R.log('SMB 账号 {} 已就绪。'.format(name), 'OK')
        else:
            R.log('SMB 账号 {} 设置失败：{}'.format(name, (p.stderr or p.stdout).strip()), 'WARN')


def smb_apply(cfg):
    smb_sync(cfg)
    smb_sync_users(cfg)
    # samba 默认配置里 server role 等不同发行版差异大，只保证 daemon 起来
    ok, out = systemctl_multi('restart', SVC['smb'])
    if not ok:
        R.log('samba 重启失败：{}'.format(out), 'ERR')
        return False
    R.log('SMB 共享已发布：\\\\{}\\<共享名>'.format(socket.gethostname()), 'OK')
    return True


