# ============================================================
# WebDAV（内置纯 Python 服务器）
# ============================================================

def dav_resolve(share, rel):
    """把 URL 相对路径解析为共享内的绝对路径，杜绝越界。"""
    rel = rel.replace('\\', '/')
    rel = re.sub(r'^/+', '', rel)
    root = os.path.realpath(share['path'])
    full = os.path.realpath(os.path.join(root, rel))
    if full != root and not full.startswith(root + os.sep):
        return None
    return full


class DavHandler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    server_version = 'WinShareManager-DAV/' + APP_VERSION

    # ---- 认证 ----
    def _authed(self):
        want = '{}:{}'.format(self.server.dav_user, self.server.dav_password)
        got = self.headers.get('Authorization') or ''
        if got.startswith('Basic '):
            try:
                if base64.b64decode(got[6:]).decode('utf-8') == want:
                    return True
            except Exception:
                pass
        self.send_response(401)
        self.send_header('WWW-Authenticate', 'Basic realm="WinShareManager"')
        self.send_header('Content-Length', '0')
        self.end_headers()
        return False

    def _find_share(self):
        """URL 第一段 = 共享名。返回 (share, rel_path) 或 None。"""
        path = self.path.split('?')[0]
        path = path.split('#')[0]
        try:
            from urllib.parse import unquote
            path = unquote(path)
        except Exception:
            pass
        parts = [p for p in path.split('/') if p]
        if not parts:
            return None, None
        for s in self.server.dav_shares:
            if s['name'] == parts[0]:
                return s, '/'.join(parts[1:])
        return None, None

    def _escape_xml(self, s):
        return s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')

    def _prop_response(self, share, rel, depth, out):
        full = dav_resolve(share, rel)
        if full is None:
            return False
        is_dir = os.path.isdir(full)
        href = '/' + share['name'] + ('/' + rel if rel else '')
        out.append('<D:response><D:href>{}</D:href><D:propstat><D:prop>'.format(self._escape_xml(href)))
        out.append('<D:displayname>{}</D:displayname>'.format(self._escape_xml(os.path.basename(href) or share['name'])))
        out.append('<D:resourcetype>{}</D:resourcetype>'.format('<D:collection/>' if is_dir else ''))
        try:
            st = os.stat(full)
            out.append('<D:getlastmodified>{}</D:getlastmodified>'.format(
                time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime(st.st_mtime))))
            if not is_dir:
                out.append('<D:getcontentlength>{}</D:getcontentlength>'.format(st.st_size))
        except OSError:
            pass
        out.append('</D:prop><D:status>HTTP/1.1 200 OK</D:status></D:propstat></D:response>')
        if is_dir and depth >= 1:
            try:
                entries = sorted(os.listdir(full))
            except OSError:
                entries = []
            for e in entries:
                child_rel = (rel + '/' if rel else '') + e
                if not self._prop_response(share, child_rel, depth - 1, out):
                    continue
        return True

    def _send(self, code, body=b'', ctype='text/plain', extra=None):
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if body and self.command != 'HEAD':
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass

    def _not_found(self):
        self._send(404, b'not found')

    # ---- 各方法 ----
    def do_OPTIONS(self):
        self._send(200, b'', extra={
            'DAV': '1,2',
            'Allow': 'OPTIONS, GET, HEAD, PUT, DELETE, PROPFIND, PROPPATCH, MKCOL, MOVE, COPY',
            'MS-Author-Via': 'DAV',
        })

    def do_PROPFIND(self):
        if not self._authed():
            return
        share, rel = self._find_share()
        if share is None:
            return self._not_found()
        depth = int((self.headers.get('Depth') or '1').strip() or 1)
        out = ['<?xml version="1.0" encoding="utf-8"?>',
               '<D:multistatus xmlns:D="DAV:">']
        if not self._prop_response(share, rel, depth, out):
            return self._not_found()
        out.append('</D:multistatus>')
        body = ''.join(out).encode('utf-8')
        self._send(207, body, 'text/xml; charset="utf-8"')

    def do_PROPPATCH(self):
        if not self._authed():
            return
        body = b'<?xml version="1.0"?><D:multistatus xmlns:D="DAV:"></D:multistatus>'
        self._send(207, body, 'text/xml; charset="utf-8"')

    def do_GET(self):
        self._dav_get()

    def do_HEAD(self):
        self._dav_get(head=True)

    def _dav_get(self, head=False):
        if not self._authed():
            return
        share, rel = self._find_share()
        if share is None:
            return self._not_found()
        full = dav_resolve(share, rel)
        if full is None or not os.path.isfile(full):
            return self._not_found()
        size = os.path.getsize(full)
        start, end, code = 0, size - 1, 200
        rng = self.headers.get('Range')
        if rng and rng.startswith('bytes='):
            m = re.match(r'bytes=(\d*)-(\d*)', rng)
            if m:
                if m.group(1):
                    start = int(m.group(1))
                if m.group(2):
                    end = int(m.group(2))
                end = min(end, size - 1)
                code = 206
        if start > end or start >= size:
            self._send(416, b'bad range')
            return
        length = end - start + 1
        self.send_response(code)
        self.send_header('Content-Type', 'application/octet-stream')
        self.send_header('Accept-Ranges', 'bytes')
        self.send_header('Content-Length', str(length))
        if code == 206:
            self.send_header('Content-Range', 'bytes {}-{}/{}'.format(start, end, size))
        self.end_headers()
        if head:
            return
        with open(full, 'rb') as f:
            f.seek(start)
            sent = 0
            while sent < length:
                chunk = f.read(min(65536, length - sent))
                if not chunk:
                    break
                try:
                    self.wfile.write(chunk)
                except (BrokenPipeError, ConnectionResetError):
                    return
                sent += len(chunk)

    def do_PUT(self):
        if not self._authed():
            return
        share, rel = self._find_share()
        if share is None or not rel:
            return self._not_found()
        full = dav_resolve(share, rel)
        if full is None:
            return self._send(403, b'forbidden')
        os.makedirs(os.path.dirname(full), exist_ok=True)
        length = int(self.headers.get('Content-Length') or 0)
        with open(full, 'wb') as f:
            remaining = length
            while remaining > 0:
                chunk = self.rfile.read(min(65536, remaining))
                if not chunk:
                    break
                f.write(chunk)
                remaining -= len(chunk)
        self._send(201 if length else 204)

    def do_MKCOL(self):
        if not self._authed():
            return
        share, rel = self._find_share()
        if share is None or not rel:
            return self._send(405, b'bad')
        full = dav_resolve(share, rel)
        if full is None or os.path.exists(full):
            return self._send(405, b'exists')
        os.makedirs(full, exist_ok=True)
        self._send(201)

    def do_DELETE(self):
        if not self._authed():
            return
        share, rel = self._find_share()
        if share is None or not rel:
            return self._send(403, b'forbidden')
        full = dav_resolve(share, rel)
        if full is None or not os.path.exists(full):
            return self._not_found()
        if os.path.isdir(full):
            shutil.rmtree(full, ignore_errors=True)
        else:
            os.remove(full)
        self._send(204)

    def _dest_path(self):
        dest = self.headers.get('Destination') or ''
        dest = re.sub(r'^https?://[^/]+', '', dest)
        try:
            from urllib.parse import unquote
            dest = unquote(dest)
        except Exception:
            pass
        return dest

    def do_MOVE(self):
        self._dav_move(copy=False)

    def do_COPY(self):
        self._dav_move(copy=True)

    def _dav_move(self, copy):
        if not self._authed():
            return
        share, rel = self._find_share()
        if share is None or not rel:
            return self._not_found()
        src = dav_resolve(share, rel)
        dparts = [p for p in self._dest_path().split('/') if p]
        if src is None or not os.path.exists(src) or len(dparts) < 2 or dparts[0] != share['name']:
            return self._not_found()
        dst = dav_resolve(share, '/'.join(dparts[1:]))
        if dst is None:
            return self._send(403, b'forbidden')
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if copy:
            if os.path.isdir(src):
                shutil.copytree(src, dst, dirs_exist_ok=True)
            else:
                shutil.copy2(src, dst)
        else:
            shutil.move(src, dst)
        self._send(201 if copy else 204)

    def log_message(self, fmt, *args):
        pass  # 静默访问日志


def dav_start_server(cfg, quiet=False):
    """创建并返回 WebDAV HTTP server（未启动线程）。"""
    shares = [s for s in cfg['shares'] if 'webdav' in (s.get('protocols') or [])]
    port = int(cfg.get('dav_port') or 8081)
    srv = ThreadingHTTPServer(('0.0.0.0', port), DavHandler)
    srv.dav_shares = shares
    srv.dav_user = cfg.get('dav_user') or 'share'
    srv.dav_password = cfg.get('dav_password') or ''
    srv.daemon_threads = True
    if not quiet:
        R.log('WebDAV 服务已就绪：http://{}:{} /<共享名>（账号 {}）'.format(
            socket.gethostname(), port, srv.dav_user), 'OK')
    return srv


def dav_write_unit(cfg):
    unit = '\n'.join([
        '[Unit]',
        'Description=WinShareManager WebDAV server',
        'After=network.target',
        '',
        '[Service]',
        'Type=simple',
        'ExecStart=/usr/bin/winsharemanager --serve',
        'Restart=on-failure',
        'RestartSec=2',
        '',
        '[Install]',
        'WantedBy=multi-user.target',
        '',
    ])
    write_text(DAV_UNIT_PATH, unit, 0o644)
    daemon_reload()


def webdav_apply(cfg, restart_service=True):
    if not cfg.get('dav_password'):
        R.log('尚未设置 WebDAV 密码（设置页里配置），服务先按空密码拒绝一切请求。', 'WARN')
    dav_write_unit(cfg)
    if restart_service:
        run(['systemctl', 'enable', DAV_SERVICE])
        ok, out = run(['systemctl', 'restart', DAV_SERVICE])
        if not ok:
            R.log('WebDAV 服务重启失败：{}'.format(out), 'ERR')
            return False
        R.log('WebDAV 已发布：http://{}:{}/<共享名>'.format(socket.gethostname(), cfg.get('dav_port')), 'OK')
    return True


