class Reporter:
    """日志收集器：GUI 模式接回调，无头模式打 stdout。"""

    def __init__(self):
        self.callback = None
        self.lines = []

    def log(self, msg, level='INFO'):
        entry = '[{}][{}] {}'.format(time.strftime('%Y-%m-%d %H:%M:%S'), level, msg)
        self.lines.append(entry)
        if self.callback:
            try:
                self.callback(entry, level)
            except Exception:
                pass
        else:
            print(entry, flush=True)


R = Reporter()


def run(cmd, timeout=60, input_text=None):
    """执行命令，返回 (ok, stdout+stderr)。永远不抛异常。"""
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=timeout,
                           input=input_text, text=(input_text is not None))
        out = (p.stdout or '') + (p.stderr or '')
        return p.returncode == 0, out.strip()
    except FileNotFoundError:
        return False, '命令不存在: {}'.format(cmd[0])
    except subprocess.TimeoutExpired:
        return False, '命令超时: {}'.format(' '.join(cmd))
    except Exception as e:
        return False, str(e)


def systemctl(action, unit):
    return systemctl_multi(action, [unit])


def systemctl_multi(action, units):
    ok_all, out_all = True, []
    for u in units:
        ok, out = run(['systemctl', action, u])
        ok_all = ok_all and ok
        if out:
            out_all.append(out)
    return ok_all, '\n'.join(out_all)


def daemon_reload():
    run(['systemctl', 'daemon-reload'])


def read_text(path, default=''):
    try:
        with open(path, 'r', encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return default


def write_text(path, content, mode=None):
    os.makedirs(os.path.dirname(path) or '/', exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)
    if mode is not None:
        os.chmod(path, mode)


def replace_marked_block(path, begin, end, new_block):
    """替换文件中 BEGIN/END 标记块；没有标记则追加。"""
    text = read_text(path)
    pattern = re.compile(re.escape(begin) + r'.*?' + re.escape(end) + r'\n?', re.S)
    body = new_block.rstrip('\n') + '\n' if new_block.strip() else ''
    if pattern.search(text):
        text = pattern.sub(body, text)
    else:
        if text and not text.endswith('\n'):
            text += '\n'
        text += '\n' + body
    write_text(path, text)


