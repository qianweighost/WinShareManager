def serve_mode():
    """systemd 调用：只跑 WebDAV，前台。"""
    cfg = load_config()
    shares = [s for s in cfg['shares'] if 'webdav' in (s.get('protocols') or [])]
    if not shares:
        print('winsharemanager: 没有启用 WebDAV 的共享，服务空转。', flush=True)
    srv = dav_start_server(cfg, quiet=True)
    print('winsharemanager: WebDAV listening on :{}'.format(cfg.get('dav_port')), flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def probe_mode():
    """部署自检：打印发行版 / 依赖 / 服务状态 / 配置摘要，退出码恒 0。"""
    family_names = {'debian': 'Debian 系（apt）', 'arch': 'Arch 系（pacman）', 'unknown': '未知（按 Debian 处理）'}
    print('distro   : {} ({}, {})'.format(DISTRO_PRETTY, DISTRO_ID, family_names.get(DISTRO_FAMILY)))
    print('python   : {}'.format(platform.python_version()))
    print('root     : {}'.format(os.geteuid() == 0))
    print('tkinter  : {}'.format(_tkinter_available()))
    cfg = load_config()
    print('config   : {} ({} 个共享)'.format(CONFIG_PATH, len(cfg['shares'])))
    for key in PROTOCOL_KEYS:
        print('proto {} : {} / 状态 {}'.format(key.ljust(6), '已装' if protocol_installed(key) else '未装',
                                              '运行' if protocol_status(key) else '停止'))
    for s in cfg['shares']:
        print('share    : {} -> {} [{}]'.format(s.get('name'), s.get('path'), ','.join(s.get('protocols') or [])))
    return 0


