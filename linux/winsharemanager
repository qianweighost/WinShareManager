PROTO_META = {
    'smb':    {'label': 'SMB',    'hint': 'Windows 文件共享，资源管理器直接访问'},
    'webdav': {'label': 'WebDAV', 'hint': '内置服务器 + systemd 常驻，账号密码登录'},
    'ftp':    {'label': 'FTP',    'hint': 'vsftpd，系统账号登录，共享 bind-mount 到根'},
    'sftp':   {'label': 'SFTP',   'hint': 'sshd 原生支持，绝对路径访问'},
    'dlna':   {'label': 'DLNA',   'hint': 'minidlna，电视/手机自动发现，无密码'},
}

PROTOCOL_KEYS = ['smb', 'webdav', 'ftp', 'sftp', 'dlna']


def install_packages(protos):
    pkgs = sorted({PKG[p] for p in protos if p in PKG})
    if not pkgs:
        return True
    if DISTRO_FAMILY == 'debian':
        R.log('正在安装：{}（apt）'.format(' '.join(pkgs)))
        run(['apt-get', 'update', '-y'], timeout=300)
        ok, out = run(['apt-get', 'install', '-y'] + pkgs, timeout=600)
    else:
        R.log('正在安装：{}（pacman）'.format(' '.join(pkgs)))
        ok, out = run(['pacman', '-S', '--noconfirm', '--needed'] + pkgs, timeout=600)
    if ok:
        R.log('依赖已安装。', 'OK')
    else:
        R.log('依赖安装失败：{}'.format(out[-400:]), 'ERR')
    return ok


def apply_shares(cfg):
    """按配置把所有共享落地（幂等，可反复点）。"""
    protos = set()
    for s in cfg['shares']:
        protos.update(s.get('protocols') or [])
    if protos:
        install_packages(protos)

    ok = True
    if 'smb' in protos:
        ok = smb_apply(cfg) and ok
    if 'ftp' in protos:
        ok = ftp_apply(cfg) and ok
    if 'sftp' in protos:
        ok = sftp_apply(cfg) and ok
    if 'dlna' in protos:
        ok = dlna_apply(cfg) and ok
    if 'webdav' in protos:
        ok = webdav_apply(cfg) and ok
    if not protos:
        R.log('当前没有任何共享，无可发布内容。', 'WARN')
    return ok


def protocol_status(key):
    """探测某协议当前是否在运行（给卡片状态灯用）。"""
    try:
        if key == 'webdav':
            ok, out = run(['systemctl', 'is-active', DAV_SERVICE])
            return out.strip() == 'active'
        for unit in SVC.get(key, []):
            ok, out = run(['systemctl', 'is-active', unit])
            if out.strip() == 'active':
                return True
        return False
    except Exception:
        return False


def protocol_installed(key):
    if key not in PKG:
        return True
    ok, out = run(['which', {
        'samba': 'smbd', 'vsftpd': 'vsftpd', 'minidlna': 'minidlnad',
    }.get(PKG[key], PKG[key])], timeout=10)
    if not ok:
        ok, out = run(['systemctl', 'list-unit-files', SVC.get(key, [key])[0] + '.service'], timeout=10)
        return ok and 'service' in out
    return True


def stop_protocol(key):
    units = SVC.get(key, [])
    if key == 'webdav':
        units = [DAV_SERVICE]
    if not units:
        return True
    ok, out = systemctl_multi('stop', units)
    if ok:
        R.log('{} 已停止。'.format(PROTO_META[key]['label']), 'OK')
    else:
        R.log('{} 停止失败：{}'.format(PROTO_META[key]['label'], out), 'ERR')
    return ok


def start_protocol(key, cfg):
    """启动某协议（先确保配置落地，再拉服务）。"""
    if key == 'smb':
        return smb_apply(cfg)
    if key == 'ftp':
        return ftp_apply(cfg)
    if key == 'sftp':
        return sftp_apply(cfg)
    if key == 'dlna':
        return dlna_apply(cfg)
    if key == 'webdav':
        return webdav_apply(cfg)
    return False


def apply_ports(cfg):
    """开放防火墙（ufw 存在就配；没有就跳过，多数桌面默认无阻拦）。"""
    ok_ufw, _ = run(['which', 'ufw'], timeout=10)
    if not ok_ufw:
        return
    ports = {21, 445, int(cfg.get('dav_port') or 8081), int(cfg.get('dlna_port') or 8200), 1900}
    for p in sorted(ports):
        run(['ufw', 'allow', str(p)], timeout=15)
    R.log('防火墙（ufw）已放行 {}。'.format(', '.join(str(p) for p in sorted(ports))), 'OK')


