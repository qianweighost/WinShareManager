def load_config():
    cfg = dict(DEFAULT_CONFIG)
    raw = read_text(CONFIG_PATH)
    if raw.strip():
        try:
            data = json.loads(raw)
            if isinstance(data, dict):
                cfg.update(data)
        except ValueError:
            pass
    if not isinstance(cfg.get('shares'), list):
        cfg['shares'] = []
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + '.tmp'
    write_text(tmp, json.dumps(cfg, ensure_ascii=False, indent=2))
    os.replace(tmp, CONFIG_PATH)
    os.chmod(CONFIG_PATH, 0o600)


def get_share(cfg, name):
    for s in cfg['shares']:
        if s.get('name') == name:
            return s
    return None


def ftp_alias(name):
    """共享名 → ASCII 别名（中文目录名在 FTP 列表会出 451），FNV-1a。"""
    if all(ord(c) < 128 for c in name) and re.match(r'^[A-Za-z0-9._-]+$', name):
        return name
    h = 2166136261
    for c in name:
        h ^= ord(c) & 0xFF
        h = (h * 16777619) & 0xFFFFFFFF
        h ^= (ord(c) >> 8) & 0xFF
        h = (h * 16777619) & 0xFFFFFFFF
    return 'ftp-{0:08x}'.format(h)


