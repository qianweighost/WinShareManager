def detect_distro():
    info = {}
    try:
        with open('/etc/os-release', 'r', encoding='utf-8') as f:
            for line in f:
                if '=' in line:
                    k, v = line.rstrip('\n').split('=', 1)
                    info[k] = v.strip('"')
    except OSError:
        pass
    distro_id = (info.get('ID') or 'linux').lower()
    like = (info.get('ID_LIKE') or '').lower()
    if distro_id in ('ubuntu', 'debian', 'linuxmint') or 'debian' in like:
        family = 'debian'
    elif distro_id in ('cachyos', 'arch', 'manjaro', 'endeavouros', 'garuda') or 'arch' in like:
        family = 'arch'
    else:
        family = 'unknown'
    return family, distro_id, info.get('PRETTY_NAME', distro_id)


DISTRO_FAMILY, DISTRO_ID, DISTRO_PRETTY = detect_distro()

