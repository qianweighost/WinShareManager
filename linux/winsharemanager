def ftp_write_conf(cfg):
    port = int(cfg.get('ftp_port') or 21)
    conf = '\n'.join([
        '# WinShareManager 管理的 vsftpd 配置（直接覆盖主配置）',
        'listen=YES',
        'listen_ipv6=NO',
        'listen_port={}'.format(port),
        'anonymous_enable=NO',
        'local_enable=YES',
        'write_enable=YES',
        'local_umask=022',
        'dirmessage_enable=YES',
        'use_localtime=YES',
        'xferlog_enable=YES',
        'connect_from_port_20=YES',
        'chroot_local_user=YES',
        'allow_writeable_chroot=YES',
        'local_root={}'.format(FTP_ROOT),
        'secure_chroot_dir=/var/run/vsftpd/empty',
        'pam_service_name=vsftpd',
        'utf8_filesystem=YES',
        '',
    ])
    write_text('/etc/vsftpd.conf', conf, 0o644)


def ftp_sync_mounts(cfg):
    """每个 FTP 共享：bind-mount 到 FTP_ROOT/<alias>，并写 fstab 标记块保持久。"""
    os.makedirs(FTP_ROOT, exist_ok=True)
    wanted = {}
    for s in cfg['shares']:
        if 'ftp' in (s.get('protocols') or []):
            wanted[ftp_alias(s['name'])] = s['path']

    # 建/更新 bind mount
    for alias, src in wanted.items():
        dst = os.path.join(FTP_ROOT, alias)
        os.makedirs(dst, exist_ok=True)
        if not os.path.ismount(dst):
            ok, out = run(['mount', '--bind', src, dst])
            if ok:
                R.log('FTP 目录已映射（bind）：{} -> {}'.format(dst, src), 'OK')
            else:
                R.log('bind mount 失败 {}: {}'.format(dst, out), 'ERR')

    # 清掉已删除共享的挂载
    for entry in os.listdir(FTP_ROOT):
        dst = os.path.join(FTP_ROOT, entry)
        if entry not in wanted and os.path.ismount(dst):
            run(['umount', dst])
            try:
                os.rmdir(dst)
            except OSError:
                pass

    # fstab 标记块（持久化）
    lines = [FSTAB_MARK_BEGIN]
    for alias, src in wanted.items():
        lines.append('{}  {}  none  bind  0  0'.format(src, os.path.join(FTP_ROOT, alias)))
    lines.append(FSTAB_MARK_END)
    replace_marked_block('/etc/fstab', FSTAB_MARK_BEGIN, FSTAB_MARK_END, '\n'.join(lines))


def ftp_apply(cfg):
    ftp_write_conf(cfg)
    ftp_sync_mounts(cfg)
    ok, out = systemctl_multi('restart', SVC['ftp'])
    if not ok:
        R.log('vsftpd 重启失败：{}'.format(out), 'ERR')
        return False
    R.log('FTP 已发布：ftp://{}:{}（系统账号登录，共享在根目录下）'.format(socket.gethostname(), cfg.get('ftp_port')), 'OK')
    return True


